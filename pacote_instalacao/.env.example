# Preencha o caminho da pasta onde os comprovantes sao salvos hoje e
# renomeie este arquivo para ".env" (sem o ".example" no final).
PASTA_ENTRADA=C:\PREENCHER\CAMINHO\DA\PASTA\DE\ENTRADA

# Os campos abaixo sao opcionais. Se voce nao mexer neles, o programa cria
# automaticamente, do lado do RenomeadorComprovantes.exe:
#   - a pasta "Renomeados" (comprovantes organizados por empresa)
#   - o arquivo "relatorio_processamento.xlsx"
#   - a pasta "logs"
# Descomente e ajuste so se quiser outro lugar.
# PASTA_SAIDA=C:\Caminho\Para\Renomeados
# CAMINHO_RELATORIO=C:\Caminho\Para\relatorio_processamento.xlsx
# CAMINHO_LOG=C:\Caminho\Para\logs\app.log

INTERVALO_POLLING_SEGUNDOS=20
CHECKS_ESTABILIZACAO=2
